# Server
PORT=4310
HOST=127.0.0.1
DATA_DIR=./data

# Required for non-loopback or production deployments.
ADMIN_TOKEN=replace-with-a-long-random-token
MASTER_KEY=replace-with-32-byte-base64-key

# Network safety. Keep disabled unless a destination must reach a private service.
ALLOW_PRIVATE_WEBHOOKS=false
ALLOW_INSECURE_HTTP=false

# Queue behavior
DELIVERY_WORKERS=2
MAX_DELIVERY_ATTEMPTS=4
RETRY_BASE_MS=2000

# Optional canonical base URL shown in integrations.
PUBLIC_URL=
